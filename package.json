{
  "name": "itsc-postgresql",
  "version": "2.0.0",
  "private": true,
  "description": "Sistema académico independiente del Instituto Tecnológico Santa Cruz",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node db/seed.mjs",
    "etl": "node db/etl.mjs",
    "setup": "node scripts/setup.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "stop": "node scripts/stop.mjs",
    "dev": "node scripts/start.mjs --dev",
    "test": "node tests/integration.mjs",
    "test:integration": "node tests/integration.mjs",
    "backup": "node scripts/backup.mjs",
    "export:demo": "node scripts/export-demo.mjs"
  },
  "dependencies": {
    "@prisma/client": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3"
  },
  "overrides": {
    "exceljs": { "uuid": "11.1.1" }
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "typescript": "~5.9.3",
    "tsx": "^4.20.6",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
